   "id": "a385eaa7-2fe8-4a01-876d-42ff7e13931d",
   "metadata": {},
   "outputs": [],
   "source": [
    "img = cv2.imread('img1.jpeg', cv2.IMREAD_COLOR)"
   ]
  },
  {
   "cell_type": "code",
