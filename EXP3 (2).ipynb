   "id": "6ad622d7-5242-439c-b0e3-a188281b0813",
   "metadata": {},
   "outputs": [],
   "source": [
    "img_hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "e618252c-2b7e-410f-9517-0dd74e80b51d",
   "metadata": {},
   "outputs": [],
   "source": [
    "img_hsv[:,:,2] = cv2.equalizeHist(img_hsv[:, :, 2])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "64b46f24-4bb4-4b85-bf48-8ddc1a7fcdf1",
   "metadata": {},
   "outputs": [],
   "source": [
